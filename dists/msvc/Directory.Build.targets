<Project>
  <!--
    Auto-copy dependency runtime DLLs from the vcpkg tree ($(SCUMMVM_LIBS)) into the
    build output folder next to scummvm.exe. create_project does not emit a post-build
    copy for a plain (non-installer) generation, and its postbuild.cmd only handles
    SDL anyway - so this fills the gap for the full vcpkg dependency set.

    Scoped to the final executable (ConfigurationType=Application) so it does not run
    for the static-library engine projects. Release links the release CRT and needs
    bin\; Debug/ASan/LLVM link the debug CRT (MDd) and need debug\bin\ (the *d.dll set).
    This file is NOT generated by create_project, so it survives regeneration.
  -->
  <Target Name="CopyDependencyDlls" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <PropertyGroup>
      <_ScummVMDllDir Condition="'$(Configuration)' == 'Release'">$(SCUMMVM_LIBS)\bin</_ScummVMDllDir>
      <_ScummVMDllDir Condition="'$(Configuration)' != 'Release'">$(SCUMMVM_LIBS)\debug\bin</_ScummVMDllDir>
    </PropertyGroup>
    <ItemGroup>
      <_ScummVMDlls Include="$(_ScummVMDllDir)\*.dll" />
    </ItemGroup>
    <Message Importance="high" Text="Copying dependency DLLs from $(_ScummVMDllDir) to $(OutDir)" />
    <Copy SourceFiles="@(_ScummVMDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
